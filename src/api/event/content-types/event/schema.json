{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "site_url": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "main_title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "event_date": {
      "type": "datetime",
      "required": true
    },
    "confirmation_deadline": {
      "type": "date"
    },
    "background_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery_image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "music": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "audios"
      ]
    },
    "message": {
      "type": "richtext"
    },
    "dress_code": {
      "type": "string"
    },
    "dress_code_note": {
      "type": "text"
    },
    "color_palette": {
      "type": "json"
    },
    "gift_message": {
      "type": "richtext"
    },
    "bank_account": {
      "type": "string"
    },
    "clabe": {
      "type": "string"
    },
    "is_manageable": {
      "type": "boolean",
      "default": false
    },
    "whatsapp_message": {
      "type": "richtext"
    },
    "gift_registry": {
      "type": "component",
      "component": "event.gift-registry",
      "repeatable": true
    },
    "schedule": {
      "type": "component",
      "component": "event.schedule-item",
      "repeatable": true
    },
    "locations": {
      "type": "component",
      "component": "event.location",
      "repeatable": true
    },
    "guests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::guest.guest",
      "mappedBy": "event"
    },
    "tables": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::table.table",
      "mappedBy": "event"
    },
    "admins": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    },
    "event_host_names": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "checklistItems": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-checklist-item.event-checklist-item",
      "mappedBy": "event"
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "wedding",
        "birthday",
        "corporate",
        "baptism"
      ]
    },
    "template": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::checklist-template.checklist-template"
    },
    "gift_cash_message": {
      "type": "richtext"
    },
    "gift_bank_message": {
      "type": "richtext"
    }
  }
}
