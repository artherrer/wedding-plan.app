{
  "kind": "collectionType",
  "collectionName": "checklist_templates",
  "info": {
    "singularName": "checklist-template",
    "pluralName": "checklist-templates",
    "displayName": "ChecklistTemplate"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "wedding",
        "birthday",
        "corporate",
        "baptism"
      ]
    },
    "isDefault": {
      "type": "boolean",
      "default": false
    },
    "sections": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::checklist-section.checklist-section",
      "mappedBy": "template"
    }
  }
}
